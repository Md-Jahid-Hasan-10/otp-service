# Copy this file to .env and fill in the values for your environment.
# .env is git-ignored and must never be committed.

# Redis - the OTP store (this service has no database)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka
EUREKA_URL=http://localhost:8761/eureka

# Key used to hash the OTP code - must be identical everywhere it is verified
OTP_HASH_SECRET=change-me

# Base64 32-byte AES key - must be identical to the notification-service key
# generate with: openssl rand -base64 32
EVENT_CRYPTO_KEY=change-me

# Log the OTP code in the console (development only)
OTP_LOG_DEV=false
